# Django port of the DistroPedia backend. Env names are unchanged from the
# original Express .env, so values copy over directly.

# --- server ---
DEBUG=true
ALLOWED_HOSTS=*

# Origin (the Vite dev server) allowed to call /api cross-origin. Same-origin
# requests ignore this.
CLIENT_URL=http://localhost:5173

# --- database ---
# SQLite file lives at django/db.sqlite3 — no connection string needed.
# DJANGO_SECRET_KEY signs sessions; JWT_SECRET signs the API bearer tokens.
DJANGO_SECRET_KEY=change-me
JWT_SECRET=change-me

# --- optional: Sign in with Google (inert when unset, as before) ---
# GOOGLE_CLIENT_ID=

# --- AI chat (Groq). Comma-separated lists allowed; 429/401 rotates keys ---
# GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# GROQ_API_KEY_4=
# GROQ_API_KEY_5=
GROQ_MODEL=openai/gpt-oss-120b

# --- quiz verdict + channel suggestions + moderation (Jev / TypeSafe) ---
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# --- password-reset delivery: smtp when SMTP_HOST set, else console log ---
# RESET_DELIVERY=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- seed command: admin account created by `manage.py seed` ---
ADMIN_EMAIL=admin@distropedia.local
ADMIN_PASSWORD=admin1234
